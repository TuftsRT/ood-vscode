# Export the module function if it exists
[[ $(type -t module) == "function" ]] && export -f module

# Find available port to run server on
export port=$(find_port ${host})

# Export compute node the script is running on
export host="${host}"

# Generate a random password. `password` (lowercase) is consumed by
# view.html.erb for the auto-login form/cookie; `PASSWORD` (uppercase) is the
# variable code-server reads when launched with `--auth password`.
export password="$(create_passwd 16)"
export PASSWORD="${password}"