---
<%
@partition_filter = :all
@partition_qos_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/partition_qos.rb'
_partial_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/resource_discovery.erb'
_resource_result = ERB.new(File.read(_partial_path)).result(binding)
%>
cluster: "pax"

bc_dynamic_js: true
form:
  - partition
  - bc_num_hours
  - num_cores
  - num_memory
  - gpu_type
  - version
  - ta_qos

attributes:
  ta_qos:
    widget: check_box
    label: "Request priority start"
    cacheable: false
    help: |
      Submits the job with `--qos=interactive` for higher scheduling priority, so it
      starts sooner. Intended for short, small sessions: while the box is checked, the
      resource fields above are automatically capped to the interactive QOS limits and
      a notice below lists them. Leave this box unchecked if your job needs more time
      or resources than those limits allow.
    value: "normal"
    checked_value: "interactive"
    unchecked_value: "normal"
<%= generate_partition_field.indent(2) %>
<%= generate_gpu_type_field.indent(2) %>
<%= generate_num_cores_field.indent(2) %>
<%= generate_num_memory_field.indent(2) %>
<%= generate_num_hours_field.indent(2) %>

  version:
    widget: select
    label: "Code Server Version"
    options:
      - [ "4.126.0", "vscode-server/4.126.0"]
      - [ "4.105.1", "vscode-server/4.105.1"]


